# Copy to .env and fill in.

NODE_ENV=development
PORT=5050

MONGODB_URI=mongodb://127.0.0.1:27017/youthverse

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# AI provider: "mock" needs no key and returns canned responses.
# Switch to "anthropic" once ANTHROPIC_API_KEY is set.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Where the Wellbeing module points a student who needs a person rather than a
# page. One line, e.g. "Campus counselling, Block C — 10am-5pm, ext. 4412".
#
# Deliberately blank by default. The right service is institution-specific, and
# a number that is wrong for the reader is worse than none: with this unset,
# the app refers to kinds of people ("someone you trust", "your institution's
# counselling service") and never invents a service. Fill it in before running
# this anywhere real.
SUPPORT_CONTACT=
